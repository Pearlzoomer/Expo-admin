# Copy to functions/.env before deploying.
# Email (any SMTP; for Gmail use an App Password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourprogram@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Tech Career Explorer <yourprogram@gmail.com>"
# Automatic Google Meet links (optional; if empty, mentors paste a Meet link when accepting):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
